rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Médias de quiz : lecture publique, écriture par le propriétaire (host),
    // images uniquement, < 3 Mo.
    match /quiz-media/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
