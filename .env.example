# Engendré par `pwa-env sync` depuis config/env.manifest.json.
# App : mister-qowa
# Ne pas éditer à la main : modifier le manifeste, puis relancer sync --write.

# Endpoint d’erreurs
VITE_ERROR_ENDPOINT=

# Firebase API key
VITE_FIREBASE_API_KEY=

# Firebase app id
VITE_FIREBASE_APP_ID=

# Firebase App Check key
VITE_FIREBASE_APPCHECK_KEY=

# Firebase auth domain
VITE_FIREBASE_AUTH_DOMAIN=

# Firebase Realtime Database URL
VITE_FIREBASE_DATABASE_URL=

# Firebase messaging sender
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Firebase project id
VITE_FIREBASE_PROJECT_ID=

# Firebase storage bucket
VITE_FIREBASE_STORAGE_BUCKET=

# Clé projet PostHog (nuage EU)
# Repli : absent : pas de mesure ni bandeau
VITE_POSTHOG_KEY=

# Adresse pour exercer les droits (acces, rectification, opposition)
VITE_PRIVACY_CONTACT=

# Responsable du traitement affiche dans la notice de confidentialite
VITE_PRIVACY_CONTROLLER=

# Fondement juridique des rapports d erreur (mention d exploitant)
VITE_PRIVACY_ERROR_BASIS=

# Duree de conservation des donnees detaillees, en mois (PostHog)
VITE_PRIVACY_RETENTION_MONTHS=

# Exiger App Check
VITE_REQUIRE_APPCHECK=

# DSN Sentry
# Repli : absent : no-op
VITE_SENTRY_DSN=

# Émulateur Firebase
VITE_USE_EMULATOR=
