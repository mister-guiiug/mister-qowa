# Config Firebase (projet web). Copier en `.env.local` et remplir.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clé de site reCAPTCHA Enterprise pour App Check (anti-abus). Optionnel en dev.
VITE_FIREBASE_APPCHECK_KEY=

# Mettre à 1 pour brancher les émulateurs Firebase locaux (jeu jouable sans projet cloud).
VITE_USE_EMULATOR=0
