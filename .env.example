# Config Firebase (projet web). Copier en `.env.local` et remplir.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clé de site reCAPTCHA Enterprise pour App Check (anti-abus). Optionnel en dev.
VITE_FIREBASE_APPCHECK_KEY=

# App Check OBLIGATOIRE en production : "true" pour refuser de démarrer le jeu
# sans clé App Check (fail-safe, `src/firebase/env.ts`). Laisser vide tant
# qu'App Check n'est pas provisionné (console + secret de déploiement) : un
# build de prod sans clé serait sinon bloqué. Sans effet avec les émulateurs.
VITE_REQUIRE_APPCHECK=

# Mettre à 1 pour brancher les émulateurs Firebase locaux (jeu jouable sans projet cloud).
VITE_USE_EMULATOR=0

# Clé de projet PostHog (`phc_…`), nuage EUROPÉEN — la MÊME pour tout le parc :
# un seul projet, les applications distinguées dedans par `app_name`, que le
# socle déduit du chemin de base. Publique par conception (elle est dans le
# bundle). Absente, le bandeau de consentement ne rend rien et rien n'est
# mesuré — c'est le seul interrupteur.
VITE_POSTHOG_KEY=

# Point de collecte Sentry. Absent, le SDK n’est même pas téléchargé :
# `initSentry` sort avant l’import. C’est le seul interrupteur.
VITE_SENTRY_DSN=

# Collecteur d'erreurs « Sentry-lite » (`src/lib/report.ts`) : URL où chaque
# erreur structurée part en best-effort par `navigator.sendBeacon`. Absente,
# l'erreur n'est que journalisée en console.
VITE_ERROR_ENDPOINT=
