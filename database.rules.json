{
  "rules": {
    "pins": {
      "$pin": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.isString()",
        ".validate": "newData.isString()"
      }
    },
    "sessions": {
      "$sid": {
        "meta": {
          ".read": true,
          ".write": "auth != null && (!data.exists() ? newData.child('hostUid').val() === auth.uid : data.child('hostUid').val() === auth.uid)"
        },

        "state": {
          ".read": true,
          ".write": "auth != null && root.child('sessions').child($sid).child('meta').child('hostUid').val() === auth.uid"
        },
        "current": {
          ".read": true,
          ".write": "auth != null && root.child('sessions').child($sid).child('meta').child('hostUid').val() === auth.uid"
        },
        "scores": {
          ".read": true,
          ".write": "auth != null && root.child('sessions').child($sid).child('meta').child('hostUid').val() === auth.uid"
        },
        "reveal": {
          ".write": "auth != null && root.child('sessions').child($sid).child('meta').child('hostUid').val() === auth.uid",
          "$qid": {
            "correct": { ".read": true },
            "$uid": {
              ".read": "auth != null && (auth.uid === $uid || root.child('sessions').child($sid).child('meta').child('hostUid').val() === auth.uid)"
            }
          }
        },
        "leaderboard": {
          ".read": true,
          ".write": "auth != null && root.child('sessions').child($sid).child('meta').child('hostUid').val() === auth.uid"
        },

        "teamLeaderboard": {
          ".read": true,
          ".write": "auth != null && root.child('sessions').child($sid).child('meta').child('hostUid').val() === auth.uid"
        },

        "reactions": {
          ".read": true,
          "$rid": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['emoji','ts'])",
            "emoji": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "ts": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        },

        "players": {
          ".read": true,
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('sessions').child($sid).child('meta').child('hostUid').val() === auth.uid) && !root.child('sessions').child($sid).child('meta').child('banned').child($uid).exists()",
            ".validate": "newData.hasChildren(['pseudo','joinedAt'])",
            "pseudo": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
            },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "lastSeen": { ".validate": "newData.isNumber()" },
            "teamId": { ".validate": "newData.isString()" },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "$other": { ".validate": false }
          }
        },

        "answers": {
          ".read": "auth != null && root.child('sessions').child($sid).child('meta').child('hostUid').val() === auth.uid",
          "$qid": {
            ".write": "auth != null && root.child('sessions').child($sid).child('meta').child('hostUid').val() === auth.uid && !newData.exists()",
            "$shard": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('sessions').child($sid).child('state').val() === 'QUESTION_ACTIVE' && now < (root.child('sessions').child($sid).child('current').child('activatedAt').val() + root.child('sessions').child($sid).child('current').child('timeLimitMs').val())",
                ".validate": "newData.hasChildren(['choice','serverTs'])",
                "choice": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
                },
                "serverTs": { ".validate": "newData.val() === now" },
                "$other": { ".validate": false }
              }
            }
          }
        }
      }
    }
  }
}
