rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Quiz : lecture publique, écriture par le propriétaire (host) authentifié.
    match /quizzes/{quizId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // Résultats : écrits UNIQUEMENT par les Functions (Admin SDK). Lecture
    // réservée à l'hôte de la partie (données joueurs = RGPD, D11).
    match /results/{gameId} {
      allow read: if request.auth != null
        && resource.data.hostUid == request.auth.uid;
      // Le host archive sa propre partie (mode Spark, autorité côté host).
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
